<Window x:Class="NoteBook.EditExamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create an exam"
        Height="300"
        Width="520"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Module -->
        <Label Grid.Row="0" Grid.Column="0" Content="Module :" VerticalAlignment="Center"/>
        <ComboBox x:Name="modules" Grid.Row="0" Grid.Column="1" Margin="5" DisplayMemberPath="Name"/>

        <!-- Date -->
        <Label Grid.Row="0" Grid.Column="2" Content="Date :" VerticalAlignment="Center"/>
        <DatePicker x:Name="datePicker" Grid.Row="0" Grid.Column="3" Margin="5"/>

        <!-- Absent -->
        <CheckBox x:Name="absentCheckBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Absent" Margin="5" VerticalAlignment="Center"/>

        <!-- Teacher -->
        <Label Grid.Row="1" Grid.Column="2" Content="Teacher :" VerticalAlignment="Center"/>
        <TextBox x:Name="teacherTextBox" Grid.Row="1" Grid.Column="3" Margin="5"/>

        <!-- Score -->
        <Label Grid.Row="2" Grid.Column="0" Content="Score :" VerticalAlignment="Center"/>
        <TextBox x:Name="scoreTextBox" Grid.Row="2" Grid.Column="1" Margin="5" Width="80" HorizontalAlignment="Left"/>

        <!-- Boutons -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,20,0,0">
            <Button Content="Validate" Width="90" Margin="5" Click="Validate_Click"/>
            <Button Content="Cancel" Width="90" Margin="5" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>