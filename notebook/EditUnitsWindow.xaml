<Window x:Class="NoteBook.EditUnitsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Units" Height="350" Width="450"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <!-- Définition des lignes -->
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <!-- def des colonnes pour boutons -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Label : "Cours Units :" -->
        <Label Grid.Row="0" 
               Content="Cours Units :"
               VerticalAlignment="Top"
               Margin="10,44,10,0"
               Grid.ColumnSpan="2"/>

        <!-- ListBox pour afficher les unités -->
        <ListBox x:Name="units" SelectionChanged="SelectUnit" MouseDoubleClick="EditUnit" Grid.Row="1" Grid.ColumnSpan="2"  Margin="10"/>

        <!-- Bouton Add -->
        <Button Grid.Row="2" Grid.Column="0"
                Content="Add"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="10"
                MinWidth="80" MouseDoubleClick="AddUnit"/>

        <!-- Bouton Remove -->
        <Button Grid.Row="2" Grid.Column="1"
                Content="Remove"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="10"
                MinWidth="80" MouseDoubleClick="RemoveUnit"/>

        <!-- ListBox pour afficher les modules -->
        <ListBox x:Name="Modules"  Grid.Row="1" Grid.ColumnSpan="2"  Margin="10,10,10,10" Grid.Column="2"/>
        
        <Label 
            Content="Modules :"
            VerticalAlignment="Top"
            Margin="10,44,10,0"
            Grid.ColumnSpan="2" Grid.Column="2"/>

        <!-- Bouton Add -->
        <Button Grid.Row="2" Grid.Column="2"
        Content="Add"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Padding="10"
        MinWidth="80" MouseDoubleClick="AddUnit"/>

        <!-- Bouton Remove -->
        <Button Grid.Row="2" Grid.Column="3"
        Content="Remove"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Padding="10"
        MinWidth="80" MouseDoubleClick="RemoveUnit"/>

    </Grid>
</Window>