<Window x:Class="NoteBook.ListExamsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="List of exams" Height="550" Width="600">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Haut : Examens -->
            <RowDefinition Height="*"/>
            <!-- Bas : Moyennes -->
            <RowDefinition Height="Auto"/>
            <!-- Bouton -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#E0E0E0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Date" Margin="5" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="Module" Margin="5" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="Teacher" Margin="5" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="Score" Margin="5" FontWeight="Bold"/>
                </Grid>

                <ListBox x:Name="exams" Grid.Row="1" BorderThickness="0" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Date}" Margin="5"/>
                                <TextBlock Grid.Column="1" Text="{Binding Module.Name}" Margin="5"/>
                                <TextBlock Grid.Column="2" Text="{Binding Teacher}" Margin="5"/>
                                <TextBlock Grid.Column="3" Text="{Binding Score}" Margin="5"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#E0E0E0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Élément" Margin="5" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="Moyenne" Margin="5" FontWeight="Bold"/>
                </Grid>

                <ListBox x:Name="scores" Grid.Row="1" BorderThickness="0" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Element.Name}" Margin="5"/>
                                <TextBlock Grid.Column="1" Text="{Binding Average, StringFormat={}{0:F2}}" Margin="5"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Button Grid.Row="2" Content="Close" Width="100" Margin="0,10,0,0" 
                HorizontalAlignment="Center" Click="Close_Click"/>
    </Grid>
</Window>