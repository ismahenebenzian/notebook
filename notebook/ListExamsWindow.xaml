<Window x:Class="NoteBook.ListExamsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="List of exams" Height="450" Width="600">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Le tableau -->
            <RowDefinition Height="Auto"/>
            <!-- Le bouton Close -->
        </Grid.RowDefinitions>

        <!-- Conteneur principal du tableau (pour la bordure extérieure) -->
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- L'en-tête -->
                    <RowDefinition Height="*"/>
                    <!-- Les données -->
                </Grid.RowDefinitions>

                <!-- 1. L'EN-TÊTE DU TABLEAU -->
                <Grid Grid.Row="0" Background="#E0E0E0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Les bordures pour dessiner les lignes de séparation -->
                    <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,1">
                        <TextBlock Text="Date" Margin="5" FontWeight="SemiBold"/>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="0,0,1,1">
                        <TextBlock Text="Module" Margin="5" FontWeight="SemiBold"/>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="0,0,1,1">
                        <TextBlock Text="Teacher" Margin="5" FontWeight="SemiBold"/>
                    </Border>
                    <Border Grid.Column="3" BorderBrush="Gray" BorderThickness="0,0,0,1">
                        <TextBlock Text="Score" Margin="5" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <!-- 2. LA LISTBOX (Les données) -->
                <!-- On enlève la bordure de la ListBox car le Border parent s'en occupe -->
                <ListBox x:Name="exams" Grid.Row="1" HorizontalContentAlignment="Stretch" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Bordures intérieures pour chaque cellule -->
                                <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="0,0,1,1">
                                    <TextBlock Text="{Binding Date}" Margin="5"/>
                                </Border>
                                <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="0,0,1,1">
                                    <TextBlock Text="{Binding Module.Name}" Margin="5"/>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="LightGray" BorderThickness="0,0,1,1">
                                    <TextBlock Text="{Binding Teacher}" Margin="5"/>
                                </Border>
                                <Border Grid.Column="3" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding Score}" Margin="5"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>
        </Border>

        <!-- 3. LE BOUTON CLOSE -->
        <Button Grid.Row="1" Content="Close" Width="100" Margin="0,15,0,0" 
                HorizontalAlignment="Center" Click="Close_Click"/>
    </Grid>
</Window>