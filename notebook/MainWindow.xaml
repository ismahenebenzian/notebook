<Window x:Class="NoteBook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carnet de notes" Height="400" Width="600"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- 3 colonnes (Gauche, Centre, Droite) -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 3 lignes (Haut, Milieu, Bas) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- LIGNE DU HAUT -->
        <!-- 1. List Exams (à Gauche) -->
        <Button Grid.Row="2"
                Content="List Exams"
                Margin="20,20,20,20" 
                Click="GoListExams_Click" />

        <!-- 2. Saisir les matières (au Centre) -->
        <Button
                Content="Saisir les matières"
                Margin="20,20,20,20" 
                Click="GoEditUnits" />

        <!-- 3. Rentrer un examen (à Droite) -->
        <Button Grid.Row="0" Grid.Column="2"
                Content="Rentrer un examen"
                Margin="20"
                Click="GoEditExam" />

        <!-- LIGNE DU MILIEU -->
        <!-- 4. L'Image (au Centre) -->
        <Image Grid.Row="1" Grid.Column="1"
               Source="/image/notebook.png"
               Margin="20"/>

        <!-- LIGNE DU BAS -->
        <!-- 5. Afficher les moyennes (à Droite) -->
        <Button Grid.Row="2" Grid.Column="2"
                Content="Afficher les moyennes"
                Margin="20" Click="GoListExams_Click" />

    </Grid>
</Window>